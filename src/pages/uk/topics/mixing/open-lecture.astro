---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import ThemeToggle from '../../../../components/ThemeToggle.astro';
import Footer from '../../../../components/Footer.astro';
---
<BaseLayout title="Перемішування в харчових технологіях — відкрита лекція" description="45 слайдів, інженерні схеми, фотографії обладнання та доповідь для 80-хвилинної лекції." locale="uk">
  <Header><ThemeToggle slot="theme-toggle" /></Header>
  <main class="lecture-page">
    <a href="/uk/topics/mixing">← Перемішування в харчових апаратах</a>
    <div class="lecture-heading">
      <div><p class="eyebrow">ВІДКРИТА ЛЕКЦІЯ · 80 ХВИЛИН</p><h1>Перемішування в харчових технологіях</h1><p>45 слайдів: від руху рідини до вибору обладнання та оцінювання однорідності.</p></div>
      <div class="lecture-actions"><a href="/presentations/mixing/index.html" target="_blank" rel="noopener">Відкрити презентацію ↗</a><a href="/docs/mixing/open-lecture-45-slides.docx" download>Доповідь DOCX ↓</a></div>
    </div>
    <iframe src="/presentations/mixing/index.html?embed=1" title="Презентація Перемішування в харчових технологіях — 45 слайдів" allow="fullscreen" allowfullscreen></iframe>
    <p class="help">Навігація: ← →, Page Up / Page Down, Home / End. F — повноекранний режим, O — зміст, N — нотатки лектора. На слайдах із відеодемонстраціями можна вибрати локальний відеофайл.</p>
  </main>
  <Footer />
</BaseLayout>
<style>
  .lecture-page{max-width:1560px;margin:0 auto;padding:32px 24px 48px;color:var(--text-primary)}
  .lecture-page>a{color:var(--accent-blue)}.lecture-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:25px 0}
  h1{font-size:clamp(26px,3vw,40px);line-height:1.2;margin:10px 0}p{color:var(--text-secondary);line-height:1.6}.eyebrow{font-size:12px;letter-spacing:.12em;font-weight:700;color:var(--accent-green)}
  .lecture-actions{display:flex;gap:10px;flex-wrap:wrap;min-width:240px}.lecture-actions a{border:1px solid var(--border-color);padding:12px 16px;border-radius:10px;background:var(--bg-secondary);color:var(--accent-blue);text-decoration:none;font-weight:600}
  iframe{display:block;width:100%;height:880px;height:max(780px,85dvh);border:1px solid var(--border-color);border-radius:14px;background:var(--bg-secondary)}.help{font-size:14px}
  @media(max-width:900px){.lecture-page{padding:20px 12px}.lecture-heading{flex-direction:column;align-items:flex-start}iframe{height:calc(100dvh - 40px);min-height:620px;border-radius:8px}}
</style>
