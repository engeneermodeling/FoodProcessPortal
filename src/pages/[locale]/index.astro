---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ThemeToggle from "../../components/ThemeToggle.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig } from "../../config";
import { ENABLED_LOCALES } from "../../locales.config";

export function getStaticPaths() {
  return [...ENABLED_LOCALES].map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const t =
  siteConfig.translations[locale as keyof typeof siteConfig.translations];

const sections = [
  { href: `/${locale}/topics`, key: "topics", color: "blue" },
  { href: `/${locale}/problems`, key: "problems", color: "green" },
  { href: `/${locale}/practice`, key: "practice", color: "blue" },
  { href: `/${locale}/reference`, key: "reference", color: "green" },
  { href: `/${locale}/courses`, key: "courses", color: "blue" },
  { href: `/${locale}/videos`, key: "videos", color: "green" },
];

---

<BaseLayout title={siteConfig.name} description={t.subtitle} locale={locale}>
  <Header>
    <ThemeToggle slot="theme-toggle" />
  </Header>

  <main class="main-content">
    <div class="container">
      <div class="hero">
        <h1 class="title">{t.welcome}</h1>
        <p class="subtitle">{t.subtitle}</p>
        <div class="hero-line"></div>
      </div>

      <nav class="nav-grid">
        {
          sections.map((section, index) => {
            const sectionData =
              t.sections[section.key as keyof typeof t.sections];
            return (
              <a href={section.href} class={`card card-${section.color}`}>
                <div class="card-corner card-corner-tl" />
                <div class="card-corner card-corner-tr" />
                <div class="card-corner card-corner-bl" />
                <div class="card-corner card-corner-br" />
                <div class="card-header">
                  <span class="card-number">0{index + 1}</span>
                  <span class="card-icon">
                    {section.key === "topics" && "📚"}
                    {section.key === "problems" && "🧮"}
                    {section.key === "practice" && "🔬"}
                    {section.key === "reference" && "📖"}
                    {section.key === "courses" && "📝"}
                    {section.key === "videos" && "🎥"}
                  </span>
                </div>
                <h2 class="card-title">{sectionData.title}</h2>
                <p class="card-desc">{sectionData.desc}</p>
                <div class="card-footer">
                  <span class="card-link">{t.goTo} →</span>
                </div>
              </a>
            );
          })
        }
      </nav>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  @import "../../styles/home.css";
</style>
