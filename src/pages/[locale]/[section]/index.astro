---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import ThemeToggle from "../../../components/ThemeToggle.astro";
import Footer from "../../../components/Footer.astro";
import { siteConfig } from "../../../config";
import { ENABLED_LOCALES } from "../../../locales.config";

export function getStaticPaths() {
  const sections = ["videos"];
  const locales = [...ENABLED_LOCALES];

  return locales.flatMap((locale) =>
    sections.map((section) => ({
      params: { locale, section },
    })),
  );
}

const { locale, section } = Astro.params;
const t =
  siteConfig.translations[locale as keyof typeof siteConfig.translations];
const sectionData = t.sections[section as keyof typeof t.sections];

const sectionIcons: Record<string, string> = {
  videos: "🎥",
};

const icon = sectionIcons[section as string] || "📄";
---

<BaseLayout
  title={sectionData.title}
  description={sectionData.desc}
  locale={locale}
>
  <Header>
    <ThemeToggle slot="theme-toggle" />
  </Header>

  <main class="main-content">
    <div class="container">
      <div class="hero">
        <div class="section-icon">{icon}</div>
        <h1 class="title">{sectionData.title}</h1>
        <p class="subtitle">{sectionData.desc}</p>
        <div class="hero-line"></div>
      </div>

      <div class="placeholder-content">
        <div class="placeholder-card">
          <h2>{t.underConstructionTitle}</h2>
          <p>{t.underConstructionText}</p>
          <div class="placeholder-features">
            <div class="feature">
              <span class="feature-icon">⏳</span>
              <span>{t.feature1}</span>
            </div>
            <div class="feature">
              <span class="feature-icon">📚</span>
              <span>{t.feature2}</span>
            </div>
            <div class="feature">
              <span class="feature-icon">✨</span>
              <span>{t.feature3}</span>
            </div>
          </div>
          <a href={`/${locale}`} class="back-home">{t.backHome}</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  @import "../../../styles/section.css";
</style>
