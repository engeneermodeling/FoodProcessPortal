---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import ThemeToggle from "../../../components/ThemeToggle.astro";
import Footer from "../../../components/Footer.astro";
import { siteConfig } from "../../../config";

const allTopics = import.meta.glob("/src/content/topics/**/*.md", {
  eager: true,
});

export function getStaticPaths() {
  return ["uk", "ru", "en", "de"].map((locale) => ({
    params: { locale },
  }));
}

const { locale } = Astro.params;
const t =
  siteConfig.translations[locale as keyof typeof siteConfig.translations];

// Отримуємо всі теми для поточної мови
const topics = Object.entries(allTopics)
  .filter(([path]) => path.includes(`/${locale}/`))
  .map(([path, module]: [string, any]) => ({
    slug: path.split("/").pop()?.replace(".md", "") || "",
    ...module.frontmatter,
  }))
  .sort((a, b) => (a.order || 0) - (b.order || 0));

// Отримуємо унікальні категорії
const categories = [
  "all",
  ...new Set(topics.map((t) => t.category).filter(Boolean)),
];
---

<BaseLayout
  title={t.sections.topics.title}
  description={t.sections.topics.desc}
  locale={locale}
>
  <Header>
    <ThemeToggle slot="theme-toggle" />
  </Header>

  <main class="main-content">
    <div class="container">
      <div class="hero">
        <h1 class="title">{t.sections.topics.title}</h1>
        <p class="subtitle">{t.sections.topics.desc}</p>
        <div class="hero-line"></div>
      </div>

      <!-- Пошук -->
      <div class="search-container">
        <div class="search-box">
          <span class="search-icon">🔍</span>
          <input
            type="text"
            id="topic-search"
            class="search-input"
            placeholder={t.searchPlaceholder}
          />
          <button id="search-clear" class="search-clear" style="display: none;"
            >✕</button
          >
        </div>
        <div id="search-stats" class="search-stats" data-label={t.searchResults}></div>
      </div>

      

      <!-- Фільтри категорій -->
      <div class="category-filters">
        {
          categories.map((category) => (
            <button class="filter-btn" data-category={category}>
              {t.categories[category as keyof typeof t.categories] || category}
            </button>
          ))
        }
      </div>

      <!-- Список тем -->
      <div class="topics-list" id="topics-list">
        {
          topics.map((topic) => (
            <a
              href={`/${locale}/topics/${topic.slug}`}
              class="topic-card"
              data-category={topic.category || "all"}
              data-title={(topic.title || "").toLowerCase()}
              data-description={(topic.description || "").toLowerCase()}
            >
              <h2 class="topic-title">{topic.title}</h2>
              <p class="topic-excerpt">{topic.description || ""}</p>
              <span class="topic-link">{t.goTo} →</span>
            </a>
          ))
        }
      </div>

      <!-- Повідомлення про відсутність результатів -->
      <div id="no-results" class="no-results" style="display: none;">
        <div class="no-results-icon">🔍</div>
        <h3>{t.noResults}</h3>
        <p>Спробуйте змінити пошуковий запит або категорію</p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById(
      "topic-search",
    ) as HTMLInputElement;
    const searchClear = document.getElementById(
      "search-clear",
    ) as HTMLButtonElement;
    const searchStats = document.getElementById(
      "search-stats",
    ) as HTMLDivElement;
    const filterBtns = document.querySelectorAll(".filter-btn");
    const topicCards = document.querySelectorAll(".topic-card");
    const noResults = document.getElementById("no-results") as HTMLDivElement;
    const topicsList = document.getElementById("topics-list") as HTMLDivElement;

    let currentCategory = "all";
    let currentSearch = "";

    // Фільтрація тем
    function filterTopics() {
      let visibleCount = 0;
      const searchLower = currentSearch.toLowerCase();

      topicCards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category");
        const cardTitle = card.getAttribute("data-title") || "";
        const cardDescription = card.getAttribute("data-description") || "";
        const htmlCard = card as HTMLElement;

        const matchesCategory =
          currentCategory === "all" || cardCategory === currentCategory;
        const matchesSearch =
          searchLower === "" ||
          cardTitle.includes(searchLower) ||
          cardDescription.includes(searchLower);

        if (matchesCategory && matchesSearch) {
          htmlCard.style.display = "block";
          visibleCount++;
        } else {
          htmlCard.style.display = "none";
        }
      });

      // Показуємо/приховуємо повідомлення про відсутність результатів
      if (
        visibleCount === 0 &&
        (currentSearch !== "" || currentCategory !== "all")
      ) {
        noResults.style.display = "block";
        topicsList.style.display = "none";
      } else {
        noResults.style.display = "none";
        topicsList.style.display = "grid";
      }

      // Оновлюємо статистику
      if (currentSearch !== "") {
        const resultsLabel =
          searchStats.getAttribute("data-label") || "результатів";
        searchStats.textContent = `${visibleCount} ${resultsLabel}`;
        searchStats.style.display = "block";
      } else {
        searchStats.style.display = "none";
      }

      // Показуємо/приховуємо кнопку очищення
      searchClear.style.display = currentSearch !== "" ? "block" : "none";
    }

    // Обробка пошуку з debounce
    let debounceTimer: any;
    searchInput.addEventListener("input", (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(filterTopics, 200);
    });

    // Очищення пошуку
    searchClear.addEventListener("click", () => {
      searchInput.value = "";
      currentSearch = "";
      searchInput.focus();
      filterTopics();
    });

    // Обробка фільтрів категорій
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        currentCategory = btn.getAttribute("data-category") || "all";

        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        filterTopics();
      });
    });

    // Встановлюємо першу кнопку активною
    const firstBtn = filterBtns[0] as HTMLButtonElement;
    if (firstBtn) {
      firstBtn.classList.add("active");
    }
  });
</script>
