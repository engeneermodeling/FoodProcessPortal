---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import ThemeToggle from "../../../components/ThemeToggle.astro";
import Footer from "../../../components/Footer.astro";
import { ENABLED_LOCALES, ui } from "../../../locales.config";

export function getStaticPaths() {
  return [...ENABLED_LOCALES].map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;

const titles: Record<string, string> = {
  uk: "Довідник — FoodProcessPortal",
  en: "Reference — FoodProcessPortal",
  de: "Referenz — FoodProcessPortal",
  ru: "Справочник — FoodProcessPortal",
};

const headings: Record<string, string> = {
  uk: "Довідник теплофізичних властивостей",
  en: "Thermophysical Properties Reference",
  de: "Thermophysikalische Eigenschaften",
  ru: "Справочник теплофизических свойств",
};

const subtitles: Record<string, string> = {
  uk: "Бази даних для інженерних розрахунків харчових виробництв",
  en: "Databases for food engineering calculations",
  de: "Datenbanken für lebensmitteltechnische Berechnungen",
  ru: "Базы данных для инженерных расчётов пищевых производств",
};

const refs = [
  {
    href: `/${locale}/reference/water`,
    icon: "💧",
    color: "#4a90ff",
    title: { uk: "Вода та водяна пара", en: "Water & Steam", de: "Wasser & Dampf", ru: "Вода и водяной пар" },
    desc: { uk: "Розрахунок за T і P: ρ, cₚ, λ, μ, Pr, ентальпія. Насичена пара. Стандарт IAPWS-IF97.", en: "Calculate by T and P: ρ, cp, λ, μ, Pr, enthalpy. Saturated steam. IAPWS-IF97.", de: "Berechnung nach T und P: ρ, cp, λ, μ, Pr, Enthalpie. Sattdampf. IAPWS-IF97.", ru: "Расчёт по T и P: ρ, cₚ, λ, μ, Pr, энтальпия. Насыщенный пар. IAPWS-IF97." },
    badge: "IAPWS-IF97",
    features: { uk: ["Рідка вода, пара, лід", "Насичена пара за T і P", "Інтерактивний розрахунок", "Історія розрахунків"], en: ["Liquid water, steam, ice", "Saturated steam by T and P", "Interactive calculation", "Calculation history"], de: ["Flüssiges Wasser, Dampf, Eis", "Sattdampf nach T und P", "Interaktive Berechnung", "Berechnungsverlauf"], ru: ["Жидкая вода, пар, лёд", "Насыщенный пар по T и P", "Интерактивный расчёт", "История расчётов"] },
  },
  {
    href: `/${locale}/reference/fluids`,
    icon: "🌡️",
    color: "#34d399",
    title: { uk: "Теплоносії виробництв", en: "Heat Transfer Fluids", de: "Wärmeträger", ru: "Теплоносители производств" },
    desc: { uk: "Повітря, пропіленгліколь, етиленгліколь, мінеральне масло, аміак, розсіл NaCl.", en: "Air, propylene glycol, ethylene glycol, mineral oil, ammonia, NaCl brine.", de: "Luft, Propylenglykol, Ethylenglykol, Mineralöl, Ammoniak, NaCl-Sole.", ru: "Воздух, пропиленгликоль, этиленгликоль, минеральное масло, аммиак, рассол NaCl." },
    badge: "ASHRAE 2022",
    features: { uk: ["7 теплоносіїв", "Таблиці vs температура", "Лінійна інтерполяція", "Позначки небезпеки"], en: ["7 heat transfer fluids", "Tables vs temperature", "Linear interpolation", "Hazard warnings"], de: ["7 Wärmeträger", "Tabellen vs Temperatur", "Lineare Interpolation", "Gefahrenhinweise"], ru: ["7 теплоносителей", "Таблицы vs температура", "Линейная интерполяция", "Предупреждения об опасности"] },
  },
  {
    href: `/${locale}/reference/food-props`,
    icon: "🍎",
    color: "#fbbf24",
    title: { uk: "Харчові продукти і сировина", en: "Food Products & Materials", de: "Lebensmittel & Rohstoffe", ru: "Пищевые продукты и сырьё" },
    desc: { uk: "Молоко, соки, цукор, борошно, м'ясо, шоколад, олії, овочі, зернові — ρ, cₚ, λ, μ.", en: "Milk, juices, sugar, flour, meat, chocolate, oils, vegetables, grains — ρ, cp, λ, μ.", de: "Milch, Säfte, Zucker, Mehl, Fleisch, Schokolade, Öle, Gemüse, Getreide — ρ, cp, λ, μ.", ru: "Молоко, соки, сахар, мука, мясо, шоколад, масла, овощи, зерновые — ρ, cₚ, λ, μ." },
    badge: "НУХТ 2012",
    features: { uk: ["9 груп продуктів", "25+ таблиць даних", "Таблиці vs T і концентрація", "Джерела НУХТ"], en: ["9 product groups", "25+ data tables", "Tables vs T and concentration", "NUFT sources"], de: ["9 Produktgruppen", "25+ Datentabellen", "Tabellen vs T und Konzentration", "NUFT-Quellen"], ru: ["9 групп продуктов", "25+ таблиц данных", "Таблицы vs T и концентрация", "Источники НУХТ"] },
  },
];
---

<BaseLayout title={titles[locale] || titles.uk} description={subtitles[locale] || subtitles.uk} locale={locale}>
  <Header>
    <ThemeToggle slot="theme-toggle" />
  </Header>
  <main class="main-content">
    <div class="container">

      <div class="ref-hero">
        <h1 class="ref-heading">{headings[locale] || headings.uk}</h1>
        <p class="ref-subtitle">{subtitles[locale] || subtitles.uk}</p>
      </div>

      <div class="ref-grid">
        {refs.map(ref => (
          <a href={ref.href} class="ref-card" style={`--card-color: ${ref.color}`}>
            <div class="ref-card-top">
              <span class="ref-icon">{ref.icon}</span>
              <span class="ref-badge">{ref.badge}</span>
            </div>
            <h2 class="ref-card-title">{ref.title[locale] || ref.title.uk}</h2>
            <p class="ref-card-desc">{ref.desc[locale] || ref.desc.uk}</p>
            <ul class="ref-features">
              {(ref.features[locale] || ref.features.uk).map((f: string) => (
                <li>✓ {f}</li>
              ))}
            </ul>
            <div class="ref-card-arrow">
              {locale === 'uk' ? 'Відкрити' : locale === 'de' ? 'Öffnen' : locale === 'ru' ? 'Открыть' : 'Open'} →
            </div>
          </a>
        ))}
      </div>

    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .ref-hero {
    text-align: center;
    padding: 3rem 1rem 2.5rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 2.5rem;
  }
  .ref-heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    letter-spacing: -0.03em;
  }
  .ref-subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding-bottom: 3rem;
  }

  .ref-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: 14px;
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.2s ease;
    border-top: 4px solid var(--card-color, var(--accent-blue));
  }
  .ref-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.15);
    border-color: var(--card-color, var(--accent-blue));
  }

  .ref-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ref-icon { font-size: 2.25rem; line-height: 1; }
  .ref-badge {
    font-size: 0.7rem;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
    color: var(--card-color, var(--accent-blue));
    background: color-mix(in srgb, var(--card-color, var(--accent-blue)) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--card-color, var(--accent-blue)) 35%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 2rem;
    letter-spacing: 0.04em;
  }

  .ref-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }
  .ref-card-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .ref-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .ref-features li {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .ref-features li::first-letter { color: var(--card-color, var(--accent-blue)); font-weight: 700; }

  .ref-card-arrow {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--card-color, var(--accent-blue));
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border-color);
  }

  @media (max-width: 640px) {
    .ref-grid { grid-template-columns: 1fr; }
  }
</style>
