---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import ThemeToggle from "../../../components/ThemeToggle.astro";
import Footer from "../../../components/Footer.astro";
import FluidsCalc from "../../../components/fluids/FluidsCalc.jsx";
import { ENABLED_LOCALES, ui } from "../../../locales.config";

export function getStaticPaths() {
  return [...ENABLED_LOCALES].map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;

const pageTitle = {
  uk: "Теплоносії харчових виробництв — Довідник",
  en: "Heat Transfer Fluids — Food Industry Reference",
  de: "Wärmeträger — Lebensmittelindustrie Referenz",
  ru: "Теплоносители пищевых производств — Справочник",
}[locale] || "Heat Transfer Fluids";

const pageDesc = {
  uk: "Теплофізичні властивості повітря, пропіленгліколю, етиленгліколю, мінерального масла, аміаку та розсолу NaCl для харчових виробництв.",
  en: "Thermophysical properties of air, propylene glycol, ethylene glycol, mineral oil, ammonia and NaCl brine for food processing.",
  de: "Thermophysikalische Eigenschaften von Luft, Propylenglykol, Ethylenglykol, Mineralöl, Ammoniak und NaCl-Sole.",
  ru: "Теплофизические свойства воздуха, пропиленгликоля, этиленгликоля, минерального масла, аммиака и рассола NaCl.",
}[locale] || pageTitle;
---

<BaseLayout title={pageTitle} description={pageDesc} locale={locale}>
  <Header>
    <ThemeToggle slot="theme-toggle" />
  </Header>
  <main class="main-content">
    <div class="container ref-container">
      <nav class="ref-breadcrumb">
        <a href={"/" + locale}>{ui("nav.home", locale)}</a>
        <span class="bc-sep">›</span>
        <a href={"/" + locale + "/reference"}>{ui("nav.reference", locale)}</a>
        <span class="bc-sep">›</span>
        <span>{{ uk: "Теплоносії", en: "Heat Transfer Fluids", de: "Wärmeträger", ru: "Теплоносители" }[locale]}</span>
      </nav>
      <FluidsCalc locale={locale} client:load />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .ref-container { padding-top: 1rem; padding-bottom: 3rem; }
  .ref-breadcrumb {
    display: flex; align-items: center; gap: 0.4rem;
    font-size: 0.85rem; color: var(--text-secondary);
    margin-bottom: 0.5rem; flex-wrap: wrap;
  }
  .ref-breadcrumb a { color: var(--accent-blue); text-decoration: none; }
  .ref-breadcrumb a:hover { text-decoration: underline; }
  .bc-sep { color: var(--text-secondary); opacity: 0.5; }
</style>
