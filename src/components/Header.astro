---
import { Image } from "astro:assets";
import logo_light from "../../public/images/logo-light-hex.svg";

const currentPath = Astro.url.pathname;

type Locale = "uk" | "ru" | "en" | "de";

const getLocalizedPath = (newLocale: Locale) => {
  if (currentPath === "/") {
    return `/${newLocale}`;
  }

  const parts = currentPath.split("/").filter(Boolean);
  if (["uk", "ru", "en", "de"].includes(parts[0])) {
    parts[0] = newLocale;
    return "/" + parts.join("/");
  }

  return `/${newLocale}${currentPath}`;
};

const isActive = (locale: Locale) => {
  return currentPath.startsWith(`/${locale}`);
};

const currentLocale: Locale = (["uk", "ru", "en", "de"].find((l) =>
  isActive(l as Locale),
) || "uk") as Locale;

interface LanguageInfo {
  code: string;
  name: string;
}

const languages: Record<Locale, LanguageInfo> = {
  uk: { code: "UA", name: "Українська" },
  ru: { code: "RU", name: "Русский" },
  en: { code: "EN", name: "English" },
  de: { code: "DE", name: "Deutsch" },
};
import { siteConfig } from "../config";

const t =
  siteConfig.translations[
    currentLocale as keyof typeof siteConfig.translations
  ];
---

<header class="site-header" id="header">
  <div class="header-container">
    <a href={`/${currentLocale}`} class="logo-link">
      <Image
        src={logo_light}
        alt="FoodProcessPortal"
        class="logo logo-light header-logo"
        fetchpriority="high"
        decoding="async"
      />
      <span class="site-name">FoodProcessPortal</span>
    </a>

    <nav class="nav-desktop">
      <a
        href={`/${currentLocale}`}
        class="nav-link {Astro.url.pathname === `/${currentLocale}` ? 'active' : ''}"
      >
        {t.sections.home?.title || "Головна"}
      </a>
      <a
        href={`/${currentLocale}/topics`}
        class="nav-link {Astro.url.pathname.includes('/topics') ? 'active' : ''}"
      >
        {t.sections.topics.title}
      </a>
      <a
        href={`/${currentLocale}/problems`}
        class="nav-link {Astro.url.pathname.includes('/problems') ? 'active' : ''}"
      >
        {t.sections.problems.title}
      </a>
      <a
        href={`/${currentLocale}/practice`}
        class="nav-link {Astro.url.pathname.includes('/practice') ? 'active' : ''}"
      >
        {t.sections.practice.title}
      </a>
      <a
        href={`/${currentLocale}/reference`}
        class="nav-link {Astro.url.pathname.includes('/reference') ? 'active' : ''}"
      >
        {t.sections.reference.title}
      </a>
      <a
        href={`/${currentLocale}/courses`}
        class="nav-link {Astro.url.pathname.includes('/courses') ? 'active' : ''}"
      >
        {t.sections.courses.title}
      </a>
      <a
        href={`/${currentLocale}/videos`}
        class="nav-link {Astro.url.pathname.includes('/videos') ? 'active' : ''}"
      >
        {t.sections.videos.title}
      </a>
    </nav>

    <div class="header-controls">
      <div class="lang-dropdown">
        <button class="lang-dropdown-toggle" id="lang-toggle">
          <span class="lang-flag">{languages[currentLocale].code}</span>
          <svg
            class="dropdown-arrow"
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="currentColor"
          >
            <path d="M2 4L6 8L10 4"></path>
          </svg>
        </button>
        <div class="lang-dropdown-menu" id="lang-menu">
          <a
            href={getLocalizedPath("uk")}
            class="lang-dropdown-item"
            class:list={[{ active: isActive("uk") }]}
          >
            <span class="lang-code">UA</span>
            <span class="lang-name">Українська</span>
          </a>
          <a
            href={getLocalizedPath("ru")}
            class="lang-dropdown-item"
            class:list={[{ active: isActive("ru") }]}
          >
            <span class="lang-code">RU</span>
            <span class="lang-name">Русский</span>
          </a>
          <a
            href={getLocalizedPath("en")}
            class="lang-dropdown-item"
            class:list={[{ active: isActive("en") }]}
          >
            <span class="lang-code">EN</span>
            <span class="lang-name">English</span>
          </a>
          <a
            href={getLocalizedPath("de")}
            class="lang-dropdown-item"
            class:list={[{ active: isActive("de") }]}
          >
            <span class="lang-code">DE</span>
            <span class="lang-name">Deutsch</span>
          </a>
        </div>
      </div>

      <slot name="theme-toggle" />

      <button
        class="mobile-menu-toggle"
        id="mobileMenuToggle"
        aria-label="Toggle menu"
      >
        <span class="hamburger"></span>
      </button>
    </div>

    <nav class="nav-mobile" id="mobileMenu">
      <a href={`/${currentLocale}`} class="nav-link">
        {t.sections.home?.title || "Головна"}
      </a>
      <a href={`/${currentLocale}/topics`} class="nav-link">
        {t.sections.topics.title}
      </a>
      <a href={`/${currentLocale}/problems`} class="nav-link">
        {t.sections.problems.title}
      </a>
      <a href={`/${currentLocale}/practice`} class="nav-link">
        {t.sections.practice.title}
      </a>
      <a href={`/${currentLocale}/reference`} class="nav-link">
        {t.sections.reference.title}
      </a>
      <a href={`/${currentLocale}/courses`} class="nav-link">
        {t.sections.courses.title}
      </a>
      <a href={`/${currentLocale}/videos`} class="nav-link">
        {t.sections.videos.title}
      </a>
    </nav>
  </div>
</header>

<script>
  // Dropdown functionality
  const toggle = document.getElementById("lang-toggle");
  const menu = document.getElementById("lang-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", (e) => {
      e.preventDefault();
      menu.classList.toggle("show");
      toggle.classList.toggle("active");
    });

    document.addEventListener("click", (e) => {
      if (
        !toggle.contains(e.target as Node) &&
        !menu.contains(e.target as Node)
      ) {
        menu.classList.remove("show");
        toggle.classList.remove("active");
      }
    });
  }

  // Mobile Menu Toggle
  const mobileMenuToggle = document.getElementById("mobileMenuToggle");
  const mobileMenu = document.getElementById("mobileMenu");

  if (mobileMenuToggle && mobileMenu) {
    mobileMenuToggle.addEventListener("click", () => {
      mobileMenuToggle.classList.toggle("active");
      mobileMenu.classList.toggle("show");
    });
  }

  // Header scroll animation
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("header");

    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        header?.classList.add("scrolled");
      } else {
        header?.classList.remove("scrolled");
      }
    });
  });
</script>

<style>
  @import "../styles/header.css";
</style>
