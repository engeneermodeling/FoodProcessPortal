---
import { siteConfig } from "../config";
import { ENABLED_LOCALES, LOCALE_NAMES } from "../locales.config";

const currentPath = Astro.url.pathname;

// Визначаємо поточну локаль з URL
const currentLocale = (ENABLED_LOCALES.find((l) =>
  currentPath.startsWith(`/${l}`)
) || ENABLED_LOCALES[0]) as string;

// Функція для переключення мови — зберігає поточну сторінку
const getLocalizedPath = (newLocale: string) => {
  if (currentPath === "/") return `/${newLocale}`;
  const parts = currentPath.split("/").filter(Boolean);
  // Перший сегмент — локаль, замінюємо її
  const allLocales = ["uk", "ru", "en", "de"];
  if (allLocales.includes(parts[0])) {
    parts[0] = newLocale;
    return "/" + parts.join("/");
  }
  return `/${newLocale}${currentPath}`;
};

const isActive = (locale: string) => currentPath.startsWith(`/${locale}`);

const t = siteConfig.translations[currentLocale as keyof typeof siteConfig.translations];

// Список активних мов — береться з locales.config.ts
const activeLanguages = ENABLED_LOCALES.map((code) => ({
  code,
  displayCode: LOCALE_NAMES[code]?.code || code.toUpperCase(),
  name: LOCALE_NAMES[code]?.native || code,
  href: getLocalizedPath(code),
  active: isActive(code),
}));

const currentLangDisplay = LOCALE_NAMES[currentLocale]?.code || currentLocale.toUpperCase();
---

<header class="site-header" id="header">
  <div class="header-container">

    <!-- Лого -->
    <a href={`/${currentLocale}`} class="logo-link">
      <img src="/images/logo-light-hex.svg" alt="FoodProcessPortal"
        class="logo logo-light" fetchpriority="high" decoding="async" />
      <img src="/images/logo-dark-hex.svg" alt="FoodProcessPortal"
        class="logo logo-dark" fetchpriority="high" decoding="async" />
      <span class="site-name">FoodProcessPortal</span>
    </a>

    <!-- Навігація desktop -->
    <nav class="nav-desktop">
      <a href={`/${currentLocale}`} class="nav-link">{t.sections.home?.title || "Головна"}</a>
      <a href={`/${currentLocale}/topics`} class="nav-link">{t.sections.topics.title}</a>
      <a href={`/${currentLocale}/problems`} class="nav-link">{t.sections.problems.title}</a>
      <a href={`/${currentLocale}/practice`} class="nav-link">{t.sections.practice.title}</a>
      <a href={`/${currentLocale}/reference`} class="nav-link">{t.sections.reference.title}</a>
      <a href={`/${currentLocale}/courses`} class="nav-link">{t.sections.courses.title}</a>
      <a href={`/${currentLocale}/videos`} class="nav-link">{t.sections.videos.title}</a>
    </nav>

    <div class="header-controls">

      <!-- Перемикач мов — динамічний з locales.config.ts -->
      <div class="lang-dropdown">
        <button class="lang-dropdown-toggle" id="lang-toggle">
          <span class="lang-flag">{currentLangDisplay}</span>
          <svg class="dropdown-arrow" width="12" height="12"
            viewBox="0 0 12 12" fill="currentColor">
            <path d="M2 4L6 8L10 4"></path>
          </svg>
        </button>
        <div class="lang-dropdown-menu" id="lang-menu">
          {activeLanguages.map((lang) => (
            <a
              href={lang.href}
              class:list={["lang-dropdown-item", { active: lang.active }]}
            >
              <span class="lang-code">{lang.displayCode}</span>
              <span class="lang-name">{lang.name}</span>
            </a>
          ))}
        </div>
      </div>

      <slot name="theme-toggle" />

      <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
        <span class="hamburger"></span>
      </button>
    </div>

    <!-- Навігація mobile -->
    <nav class="nav-mobile" id="mobileMenu">
      <a href={`/${currentLocale}`} class="nav-link">{t.sections.home?.title || "Головна"}</a>
      <a href={`/${currentLocale}/topics`} class="nav-link">{t.sections.topics.title}</a>
      <a href={`/${currentLocale}/problems`} class="nav-link">{t.sections.problems.title}</a>
      <a href={`/${currentLocale}/practice`} class="nav-link">{t.sections.practice.title}</a>
      <a href={`/${currentLocale}/reference`} class="nav-link">{t.sections.reference.title}</a>
      <a href={`/${currentLocale}/courses`} class="nav-link">{t.sections.courses.title}</a>
      <a href={`/${currentLocale}/videos`} class="nav-link">{t.sections.videos.title}</a>
    </nav>

  </div>
</header>

<script>
  const toggle = document.getElementById("lang-toggle");
  const menu = document.getElementById("lang-menu");
  if (toggle && menu) {
    toggle.addEventListener("click", (e) => {
      e.preventDefault();
      menu.classList.toggle("show");
      toggle.classList.toggle("active");
    });
    document.addEventListener("click", (e) => {
      if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        menu.classList.remove("show");
        toggle.classList.remove("active");
      }
    });
  }

  const mobileMenuToggle = document.getElementById("mobileMenuToggle");
  const mobileMenu = document.getElementById("mobileMenu");
  if (mobileMenuToggle && mobileMenu) {
    mobileMenuToggle.addEventListener("click", () => {
      mobileMenuToggle.classList.toggle("active");
      mobileMenu.classList.toggle("show");
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("header");
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) header?.classList.add("scrolled");
      else header?.classList.remove("scrolled");
    });
  });
</script>

<style>
  @import "../styles/header.css";
</style>
