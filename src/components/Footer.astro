---
import { siteConfig } from "../config";

const currentPath = Astro.url.pathname;
const currentLocale =
  ["uk", "ru", "en", "de"].find((l) => currentPath.startsWith(`/${l}`)) || "uk";

const t =
  siteConfig.translations[
    currentLocale as keyof typeof siteConfig.translations
  ];

const year = new Date().getFullYear();
const releaseDate = new Date(siteConfig.releaseDate);
const formattedDate = releaseDate.toLocaleDateString(
  currentLocale === "uk"
    ? "uk-UA"
    : currentLocale === "ru"
      ? "ru-RU"
      : currentLocale === "de"
        ? "de-DE"
        : "en-US",
  { day: "2-digit", month: "2-digit", year: "numeric" },
);

const footerLinks = [
  { href: "/topics", key: "topics" },
  { href: "/problems", key: "problems" },
  { href: "/practice", key: "practice" },
  { href: "/reference", key: "reference" },
  { href: "/courses", key: "courses" },
  { href: "/videos", key: "videos" },
];
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-left">
        <div class="footer-logo-wrapper">
          <img src="/images/logo-light.svg" alt="" class="footer-logo" />
          <div class="footer-brand-text">
            <span class="brand-name">{siteConfig.name}</span>
            <span class="brand-tagline">{t.footer.tagline}</span>
          </div>
        </div>
        <p class="footer-desc">{t.footer.description}</p>
      </div>

      <div class="footer-right">
        <div class="footer-nav-section">
          <h4 class="footer-section-title">{t.footer.navigation}</h4>
          <nav class="footer-nav">
            {
              footerLinks.map((link) => (
                <a href={`/${currentLocale}${link.href}`} class="nav-link">
                  {t.sections[link.key as keyof typeof t.sections].title}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="footer-contacts">
          <h4 class="footer-section-title">{t.footer.contacts}</h4>
          <a href={`mailto:${siteConfig.email}`} class="contact-link">
            {siteConfig.email}
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-version">v{siteConfig.version}</span>
      <span class="footer-updated" title="Дата останнього оновлення">
        {t.footer.updated}: {formattedDate}
      </span>
      <span class="footer-copyright">© {year} {t.footer.copyright}</span>
      <span class="footer-heart"
        >{t.footer.madeWith}
        <span class="heart">♥</span>
        {t.footer.forStudents}</span
      >
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background-color: var(--bg-secondary);
    border-top: 3px solid var(--accent-blue);
    margin-top: 2rem;
    overflow: hidden;
  }

  .footer-grid-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image:
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 30px 30px;
    opacity: 0.08;
    pointer-events: none;
  }

  .footer-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.25rem 2rem 0.85rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 0.85rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .footer-logo-wrapper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-logo {
    height: 52px;
    width: auto;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent-blue);
    letter-spacing: -0.5px;
    line-height: 1.2;
  }

  .brand-tagline {
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-weight: 500;
    line-height: 1.3;
  }

  .footer-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .footer-right {
    display: flex;
    gap: 2.5rem;
  }

  @media (max-width: 768px) {
    .footer-right {
      flex-direction: column;
      gap: 1.25rem;
      width: 100%;
    }
  }

  .footer-nav-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-section-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--accent-blue);
    display: inline-block;
    width: fit-content;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.35rem 1.25rem;
  }

  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--accent-blue);
  }

  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.82rem;
    transition: all 0.2s;
  }

  .contact-link:hover {
    color: var(--accent-blue);
  }

  .footer-social {
    display: flex;
    gap: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 0.3rem;
    color: var(--text-secondary);
    transition: all 0.2s;
  }

  .social-link:hover {
    background-color: var(--accent-blue);
    color: white;
    border-color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.7rem;
    border-top: 1px solid var(--border-color);
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
    }
  }

  .footer-version {
    background-color: var(--accent-blue);
    color: white;
    padding: 0.2rem 0.55rem;
    border-radius: 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    font-family: "Segoe UI", system-ui, sans-serif;
    letter-spacing: 0.5px;
  }

  .footer-updated {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--accent-blue);
    font-family: "Segoe UI", system-ui, sans-serif;
    padding: 0.2rem 0.6rem;
    background-color: rgba(30, 58, 138, 0.1);
    border: 1px solid rgba(30, 58, 138, 0.3);
    border-radius: 0.25rem;
    font-weight: 500;
    letter-spacing: 0.3px;
  }

  .footer-updated::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background-color: var(--accent-green);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .footer-copyright {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-heart {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .heart {
    color: #ef4444;
    display: inline-block;
    animation: heartbeat 1.5s infinite;
  }

  @keyframes heartbeat {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.15);
    }
  }
</style>
