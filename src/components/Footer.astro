---
import { Image } from "astro:assets";
import logo_light from "../../public/images/logo-light-hex.svg";

import { siteConfig } from "../config";

const currentPath = Astro.url.pathname;
const currentLocale =
  ["uk", "ru", "en", "de"].find((l) => currentPath.startsWith(`/${l}`)) || "uk";

const t =
  siteConfig.translations[
    currentLocale as keyof typeof siteConfig.translations
  ];

const year = new Date().getFullYear();
const releaseDate = new Date(siteConfig.releaseDate);
const formattedDate = releaseDate.toLocaleDateString(
  currentLocale === "uk"
    ? "uk-UA"
    : currentLocale === "ru"
      ? "ru-RU"
      : currentLocale === "de"
        ? "de-DE"
        : "en-US",
  { day: "2-digit", month: "2-digit", year: "numeric" },
);

const footerLinks = [
  { href: "/topics", key: "topics" },
  { href: "/problems", key: "problems" },
  { href: "/practice", key: "practice" },
  { href: "/reference", key: "reference" },
  { href: "/courses", key: "courses" },
  { href: "/videos", key: "videos" },
];
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-left">
        <div class="footer-logo-wrapper">
          <Image
            src={logo_light}
            alt="FoodProcessPortal"
            class="footer-logo"
            fetchpriority="high"
            decoding="async"
          />
          <div class="footer-brand-text">
            <span class="brand-name">{siteConfig.name}</span>
            <span class="brand-tagline">{t.footer.tagline}</span>
          </div>
        </div>
        <p class="footer-desc">{t.footer.description}</p>
      </div>

      <div class="footer-right">
        <div class="footer-nav-section">
          <h4 class="footer-section-title">{t.footer.navigation}</h4>
          <nav class="footer-nav">
            {
              footerLinks.map((link) => (
                <a href={`/${currentLocale}${link.href}`} class="nav-link">
                  {t.sections[link.key as keyof typeof t.sections].title}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="footer-contacts">
          <h4 class="footer-section-title">{t.footer.contacts}</h4>
          <a href={`mailto:${siteConfig.email}`} class="contact-link">
            {siteConfig.email}
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-version">v{siteConfig.version}</span>
      <span class="footer-updated" title="Дата останнього оновлення">
        {t.footer.updated}: {formattedDate}
      </span>
      <span class="footer-copyright">© {year} {t.footer.copyright}</span>
      <span class="footer-heart"
        >{t.footer.madeWith}
        <span class="heart">♥</span>
        {t.footer.forStudents}</span
      >
    </div>
  </div>
</footer>

<style>
  @import "../styles/footer.css";
</style>
