---
import { siteConfig } from "../config";
import Analytics from "@vercel/analytics/astro";
import { ENABLED_LOCALES } from "../locales.config";
import { getLocalizedPath } from "../utils/routing";

interface Props {
  title: string;
  description?: string;
  locale: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = "",
  locale,
  image,
  type = "website",
} = Astro.props;
const canonicalUrl = new URL(
  Astro.url.pathname,
  Astro.site || "http://localhost:4321",
).href;
const ogImage = new URL(image || "/images/og-default.png", Astro.site || siteConfig.url).href;
const siteName = siteConfig.title;
const alternates = ENABLED_LOCALES.map((code) => ({
  locale: code,
  href: new URL(getLocalizedPath(Astro.url.pathname, code), Astro.site || siteConfig.url).href,
}));
const defaultAlternate = alternates.find((entry) => entry.locale === "uk") || alternates[0];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
    />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/favicon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={`${title} | ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preconnect до власного домену -->
    <link rel="preconnect" href={siteConfig.url} />

    <!-- Preload логотипу (якщо використовуєш) -->
    <link
      rel="preload"
      href="/images/logo-light-hex.svg"
      as="image"
      type="image/svg+xml"
    />

    <meta
      name="google-site-verification"
      content="f5nalxq8R9B9N98asYtQaqbeD03S0T-mX9BgLfKKYe4"
    />

    <!-- Hreflang для багатомовності -->
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
    ))}
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
    )}

    <!-- Styles -->
    <link rel="stylesheet" href="/styles/theme.css" />

    <!-- DNS Prefetch для CDN -->
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

    <!-- Preconnect до Google -->
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Google Analytics -->
    <script>
      // Завантажуй Google Analytics тільки після завантаження сторінки
      window.addEventListener("load", () => {
        const script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=G-65T84M0VJ4";
        document.head.appendChild(script);
      });
    </script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-65T84M0VJ4");
    </script>

    <Analytics />
  </head>
  <body>
    <slot />
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const anchors = document.querySelectorAll("a[href^='http://'], a[href^='https://']");
        const currentHost = window.location.host;

        anchors.forEach((anchor) => {
          if (!(anchor instanceof HTMLAnchorElement) || anchor.host === currentHost) return;

          anchor.target = "_blank";
          const rel = new Set(anchor.rel.split(/\s+/).filter(Boolean));
          rel.add("noopener");
          rel.add("noreferrer");
          anchor.rel = [...rel].join(" ");
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/home.css";
</style>
